{
  "version": "2026-06-12-response-router-01",
  "assistant": "IT – Osobni digitalni asistent",
  "channels": {
    "email": {
      "faq": "data/assistant_faq_mail.json",
      "signature": "signature_hr_lines",
      "default_action": "answer_or_prepare_draft"
    },
    "website_contact_form": {
      "faq": "data/assistant_faq_contact.json",
      "signature": "signature_hr_lines",
      "default_action": "acknowledge_or_prepare_draft"
    },
    "whatsapp": {
      "faq": "data/assistant_faq_whatsapp.json",
      "signature": "short_signature",
      "default_action": "short_reply_or_escalate"
    }
  },
  "decision_flow": [
    "identify_channel",
    "detect_language",
    "match_faq_tags_or_question",
    "check_training_rules",
    "compose_short_answer",
    "add_signature",
    "route_to_review_if_needed"
  ],
  "faq_match_fields": [
    "question",
    "tags",
    "id"
  ],
  "confidence_policy": {
    "high": "automatic_general_reply_allowed",
    "medium": "draft_for_owner_review",
    "low": "fallback_and_owner_review"
  },
  "log_fields": [
    "timestamp",
    "channel",
    "matched_faq_id",
    "confidence",
    "action",
    "review_required"
  ]
}
