{
  "version": "2026-06-12-command-center-contract-01",
  "module": "command_center",
  "operator_page": "/operator/command/",
  "mode": "prepare_then_confirm",
  "allowed_modules": [
    "mail",
    "news",
    "market",
    "image",
    "document",
    "status",
    "pwa",
    "whatsapp"
  ],
  "allowed_actions_initial": [
    "prepare",
    "validate",
    "preview",
    "status_check",
    "copy_package"
  ],
  "backend_actions_later": [
    "send_mail_batch",
    "refresh_news",
    "refresh_market",
    "upload_image",
    "upload_document",
    "create_summary"
  ],
  "confirmation_required": true,
  "log_required": true,
  "rollback_required_for_content_changes": true
}
